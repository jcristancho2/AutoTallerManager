    {
      "name": "6. Órdenes de Servicio",
      "item": [
        {
          "name": "Crear Orden de Servicio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": {{vehiculoId}},\n  \"mecanicoId\": 1,\n  \"tipoServicioId\": 1,\n  \"fechaIngreso\": \"2024-12-20T10:00:00Z\",\n  \"descripcionTrabajo\": \"Mantenimiento preventivo completo\",\n  \"repuestosRequeridos\": [\n    {\n      \"repuestoId\": {{repuestoId}},\n      \"cantidad\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/OrdenesServicio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "OrdenesServicio"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",

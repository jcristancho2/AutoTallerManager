        },
        {
          "name": "Obtener Tipos de Vehículo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Vehiculos/tipos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Vehiculos", "tipos"]

              "host": ["{{baseUrl}}"],
              "path": ["api", "OrdenesServicio", "{{ordenId}}", "cerrar"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('facturaId', response.facturaId);",

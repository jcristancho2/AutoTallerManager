            }
          }
        }
      ]
    },
    {
      "name": "3. Clientes",
      "item": [
        {
          "name": "Crear Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Carlos\",\n  \"apellido\": \"Pérez García\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"juan.perez@email.com\",\n  \"tipoClienteId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Clientes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('clienteId', response.id);",
                  "    console.log('Cliente ID guardado:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener Clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Clientes?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Clientes"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener Cliente por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Clientes/{{clienteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Clientes", "{{clienteId}}"]
            }
          }
        }
      ]
    },

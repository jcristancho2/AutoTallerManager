            "url": {
              "raw": "{{baseUrl}}/api/OrdenesServicio/{{ordenId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "OrdenesServicio", "{{ordenId}}", "estado"]
            }
          }
        },
        {
          "name": "Registrar Trabajo Realizado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcionTrabajoRealizado\": \"Cambio de aceite y filtro completado\",\n  \"manoDeObra\": 50.00,\n  \"repuestosUtilizados\": [\n    {\n      \"repuestoId\": {{repuestoId}},\n      \"cantidad\": 2,\n      \"precioUnitario\": 18.99,\n      \"descripcion\": \"Filtro de aceite premium\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/OrdenesServicio/{{ordenId}}/trabajo-realizado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "OrdenesServicio", "{{ordenId}}", "trabajo-realizado"]
            }
          }
        },
